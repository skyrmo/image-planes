{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "@webgpu/types"],
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        // Same mapping as the alias in vite.config.ts: type-check against the library's source.
        "paths": {
            "image-planes": ["../packages/image-planes/src/index.ts"],
            "image-planes/effects": ["../packages/image-planes/src/effects/index.ts"]
        }
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "vite.config.ts"],
}
